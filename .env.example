APP_LLM_API_KEY=sk-changeme
APP_LLM_MODEL=gpt-4o-mini
APP_REPO_PATH=/data/repo
APP_LOG_LEVEL=INFO
# Default logs contain operational fields only. Opt in only for local diagnostics:
APP_LOG_DIAGNOSTICS_ENABLED=false
# Diagnostic question/argument/error fields are clipped to 1..1000 characters.
APP_LOG_CONTENT_MAX_CHARS=200
APP_REPO_GIT_URL=https://github.com/Brunotlps/codda
# Clients must send this value in the X-API-Key header; /ask rejects everything if unset
APP_API_KEY=dev-key
# Max messages kept per conversation thread before the oldest are dropped
APP_MAX_HISTORY_MESSAGES=20
# Conversations idle this long (seconds) or beyond the thread cap (LRU) are deleted
APP_THREAD_TTL_SECONDS=86400
APP_MAX_THREADS=500
# Curated portfolio repos (see portfolio_repos.yaml); absent file = feature disabled
APP_PORTFOLIO_REPOS_PATH=portfolio_repos.yaml
APP_REPO_ROOT=/data/repos
# Adds a semantic_search tool (OpenAI embeddings) alongside grep_repo; off by default
APP_SEMANTIC_SEARCH_ENABLED=false
# Embeddings are configured independently from the chat model. URL/key default to APP_LLM_*.
APP_EMBEDDING_MODEL=text-embedding-3-small
# APP_EMBEDDING_BASE_URL=https://api.openai.com/v1
# APP_EMBEDDING_API_KEY=sk-changeme
